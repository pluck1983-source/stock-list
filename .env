# Google OAuth web client ID for sign-in and Drive sync (public - it identifies the app, it is not a secret).
# Its "Authorized redirect URIs" must include the address the app is served from, e.g.
# https://pluck1983-source.github.io/<repo-name>/ - see README. Leave empty to build a device-only app.
VITE_GOOGLE_CLIENT_ID=613676181585-9kmptnv6gjv0k7i8m61lrar96eboles7.apps.googleusercontent.com

